import { Button, TabWidget } from "std-widgets.slint";
import { SummaryRow } from "types.slint";
import { EditorBridge } from "bridge.slint";
import { NoticeBar } from "notice.slint";
import { SummaryLine } from "text.slint";
import { CharacterPage, InventoryPage } from "pages.slint";

// The editor page: the summary of the open save, the notice bar, and one tab
// per section the save can hold.
export component EditorPage inherits VerticalLayout {
    in property <SummaryRow> summary;
    callback back-requested();

    padding: 12px;
    spacing: 8px;

    HorizontalLayout {
        spacing: 12px;
        Button {
            text: @tr("Back");
            enabled: !EditorBridge.blocked;
            clicked => { root.back-requested(); }
        }
        Text {
            vertical-alignment: center;
            font-size: 16px;
            font-weight: 700;
            text: root.summary.game;
        }
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
            text: SummaryLine.rest(root.summary);
        }
    }
    if EditorBridge.has-notice: NoticeBar { }
    TabWidget {
        vertical-stretch: 1;

        Tab {
            title: @tr("Party");
            if EditorBridge.data.party.present: CharacterPage {
                pages: EditorBridge.data.party.pages;
                read-only: EditorBridge.data.party.read-only;
            }
            if !EditorBridge.data.party.present: Text {
                text: @tr("This save has no such section.");
            }
        }
        Tab {
            title: @tr("Inventory");
            if EditorBridge.data.inventory.present: InventoryPage {
                section: EditorBridge.data.inventory;
            }
            if !EditorBridge.data.inventory.present: Text {
                text: @tr("This save has no such section.");
            }
        }
        Tab {
            title: @tr("Magic");
            if EditorBridge.data.magic.present: CharacterPage {
                pages: EditorBridge.data.magic.pages;
                read-only: EditorBridge.data.magic.read-only;
            }
            if !EditorBridge.data.magic.present: Text {
                text: @tr("This save has no such section.");
            }
        }
    }
}
