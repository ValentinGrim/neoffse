import { ControlFrame, FocusRing } from "control-frame.slint";
import { FrameStyle, Look } from "../theme/look.slint";
import { Theme } from "../theme/theme.slint";

// The pieces the editor menu is drawn with. Every one reads a `Look`, the
// open game's by default, and draws with primitives only. The portrait frame
// is the one exception: it shows the image it is given.

// A panel: a bevelled frame in the PR look, one thin rule in a flat look. The
// children sit inside a padded column.
export component Frame inherits Rectangle {
    in property <Look> look: Theme.look;
    // The space between the children.
    in property <length> gap: 0px;

    ControlFrame {
        look: root.look;
        fill: root.look.panel-fill;
        line: root.look.rule;
    }
    VerticalLayout {
        padding: root.look.padding;
        spacing: root.gap;
        @children
    }
}

// A square holding the sprite of a character, or its initial when it has no
// sprite. The two lines of the frame sit outside the sprite: a caller sizes
// the frame as the sprite side plus `2 * inset`, so the sprite shows whole.
export component PortraitFrame inherits Rectangle {
    in property <Look> look: Theme.look;
    in property <string> initial;
    // The sprite of the character. An empty image (width 0) shows the initial.
    in property <image> portrait;
    // The width of the two lines, on each side. The sprite and the initial
    // lie inside it.
    out property <length> inset: 2px;
    private property <bool> has-portrait: root.portrait.width > 0;

    background: root.look.portrait-fill;

    if !root.has-portrait: Text {
        x: root.inset;
        y: root.inset;
        width: root.width - 2 * root.inset;
        height: root.height - 2 * root.inset;
        text: root.initial;
        color: root.look.muted;
        font-family: root.look.font-family;
        font-size: root.look.font-title;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.has-portrait: sprite := Image {
        x: root.inset;
        y: root.inset;
        width: root.width - 2 * root.inset;
        height: root.height - 2 * root.inset;
        source: root.portrait;
        image-fit: contain;
        image-rendering: pixelated;
        accessible-role: none;
    }
    // The lines frame the sprite and never cover it.
    edge := Rectangle {
        border-width: 1px;
        border-color: root.look.field-border;
    }
    inner-edge := Rectangle {
        x: 1px;
        y: 1px;
        width: root.width - 2px;
        height: root.height - 2px;
        border-width: 1px;
        border-color: root.look.frame-inner;
    }
}

// The marker of the current command: a right-pointing triangle.
export component Pointer inherits Path {
    in property <Look> look: Theme.look;

    commands: "M 0 0 L 12 7 L 0 14 Z";
    fill: root.look.selected;
    width: 12px;
    height: 14px;
}

// A divider between two blocks: one pixel in a flat look, the game's light
// line over a dark one in the bevel look.
export component RuleLine inherits Rectangle {
    in property <Look> look: Theme.look;
    private property <bool> banded: root.look.frame-style == FrameStyle.bevel;

    height: root.banded ? 2 * root.look.frame-width : 1px;
    background: root.banded ? transparent : root.look.rule;

    if root.banded: Rectangle {
        y: 0px;
        height: root.look.frame-width;
        background: root.look.rule;
    }
    if root.banded: Rectangle {
        y: root.look.frame-width;
        height: root.look.frame-width;
        background: root.look.rule-shadow;
    }
}

// Body text in a look: its font, its text colour, centred on the line. A
// screen overrides `color` or `font-size` on the instance.
export component LookText inherits Text {
    in property <Look> look: Theme.look;

    color: root.look.text;
    font-family: root.look.font-family;
    font-size: root.look.font-body;
    vertical-alignment: center;
}

// A row that activates on a click, on Enter and on Space. It is a focus stop
// unless disabled, shows the hover fill and a focus ring, and names itself to
// the accessibility tree. `current` fills it as the selected one.
export component PressRow inherits Rectangle {
    in property <Look> look: Theme.look;
    // The accessible name.
    in property <string> name;
    in property <bool> enabled: true;
    in property <bool> current;
    callback activated();
    out property <bool> has-focus: scope.has-focus;

    forward-focus: scope;

    scope := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        focus-on-click: false;
        accessible-role: button;
        accessible-label: root.name;
        accessible-enabled: root.enabled;
        accessible-action-default => { root.activated(); }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                if !event.repeat {
                    root.activated();
                }
                return accept;
            }
            return reject;
        }
    }
    Rectangle {
        border-radius: root.look.frame-style == FrameStyle.bevel ? root.look.frame-radius : 0px;
        background: root.current ? root.look.selected-fill : area.has-hover && root.enabled ? root.look.hover-fill : transparent;
    }
    @children
    FocusRing {
        look: root.look;
        shown: scope.has-focus;
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                scope.focus();
            }
        }
    }
}
