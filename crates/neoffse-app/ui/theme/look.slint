// The tokens every control and screen draws with. A theme is one `Look` value.

export enum FrameStyle { flat, bevel }

// Every value a control or a screen draws with.
export struct Look {
    font-family: string,
    font-family-strong: string,
    font-weight-strong: int,
    font-body: length,
    font-small: length,
    font-title: length,
    text: color,
    label: color,
    selected: color,
    muted: color,
    warning: color,
    accent: color,
    window-fill: brush,
    panel-fill: brush,
    field-fill: brush,
    portrait-fill: brush,
    hover-fill: brush,
    selected-fill: brush,
    frame-style: FrameStyle,
    frame-inner: color,
    rule: color,
    field-border: color,
    focus: color,
    frame-width: length,
    frame-radius: length,
    // The bands of the game's window frame, outside in, each `frame-width` wide.
    // Only the bevel style draws them; the flat style ignores them.
    band-1: color,
    band-2: color,
    band-3: color,
    band-4: color,
    band-5: color,
    band-6: color,
    // The dark line under `rule` in the bevel style.
    rule-shadow: color,
    padding: length,
    spacing: length,
    // The height of a list row, and the reference height of a text field or a button.
    row-height: length,
}
