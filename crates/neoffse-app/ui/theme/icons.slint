// The Material Symbols the screens draw, as images. `Icon` recolours one with a brush from the theme.

export global Icons {
    out property <image> home: @image-url("../../../../assets/icons/material-symbols/home.svg");
    out property <image> arrow-back: @image-url("../../../../assets/icons/material-symbols/arrow_back.svg");
    out property <image> add: @image-url("../../../../assets/icons/material-symbols/add.svg");
    out property <image> delete: @image-url("../../../../assets/icons/material-symbols/delete.svg");
    out property <image> search: @image-url("../../../../assets/icons/material-symbols/search.svg");
    out property <image> close: @image-url("../../../../assets/icons/material-symbols/close.svg");
    out property <image> expand-more: @image-url("../../../../assets/icons/material-symbols/expand_more.svg");
    out property <image> check: @image-url("../../../../assets/icons/material-symbols/check.svg");
    out property <image> lock: @image-url("../../../../assets/icons/material-symbols/lock.svg");
    out property <image> warning: @image-url("../../../../assets/icons/material-symbols/warning.svg");
    out property <image> refresh: @image-url("../../../../assets/icons/material-symbols/refresh.svg");
    out property <image> folder-open: @image-url("../../../../assets/icons/material-symbols/folder_open.svg");
}

// An icon drawn in one flat colour. The source files carry no fill, so `colorize` sets it.
export component Icon inherits Image {
    in property <brush> tint;
    colorize: root.tint;
    image-fit: contain;
    // The control that holds the icon carries the accessible name.
    accessible-role: none;
}
