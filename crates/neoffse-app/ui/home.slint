import { Button, CheckBox, ScrollView } from "std-widgets.slint";
import { FolderOrigin, FolderRow, GameRow, OpenProblem, SlotRow } from "types.slint";
import { SlotText, SummaryLines } from "text.slint";

// One slot: its name, its summary, and a click that opens it.
component SlotLine inherits Rectangle {
    in property <SlotRow> slot;
    in property <bool> busy;
    callback clicked(int);

    opacity: root.slot.openable ? 1.0 : 0.5;
    background: touch.has-hover && root.slot.openable && !root.busy ? #80808030 : transparent;

    touch := TouchArea {
        mouse-cursor: root.slot.openable && !root.busy ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if root.slot.openable && !root.busy {
                root.clicked(root.slot.key);
            }
        }
    }

    VerticalLayout {
        padding: 4px;
        padding-left: 24px;
        spacing: 2px;

        Text {
            text: SlotText.name(root.slot.summary.kind, root.slot.summary.number);
            font-weight: 600;
            overflow: elide;
        }
        if root.slot.summarized: SummaryLines {
            summary: root.slot.summary;
        }
        if root.slot.unreadable: Text {
            text: @tr("This save cannot be read");
            overflow: elide;
        }
    }
}

component SlotList inherits VerticalLayout {
    in property <[SlotRow]> slots;
    in property <bool> busy;
    callback clicked(int);

    for slot in root.slots: SlotLine {
        slot: slot;
        busy: root.busy;
        clicked(key) => { root.clicked(key); }
    }
}

component FolderBlock inherits VerticalLayout {
    in property <FolderRow> folder;
    in property <bool> busy;
    callback clicked(int);

    pure function origin-text(origin: FolderOrigin) -> string {
        if origin == FolderOrigin.steam-proton {
            return @tr("Steam (Proton)");
        }
        if origin == FolderOrigin.documents {
            return @tr("Documents");
        }
        return @tr("Other location");
    }

    Text {
        text: root.folder.account > 0 ? @tr("{}, account {}", origin-text(root.folder.origin), root.folder.account) : origin-text(root.folder.origin);
        font-italic: true;
        overflow: elide;
    }
    if root.folder.slots.length == 0: Text {
        text: @tr("No save found");
        overflow: elide;
    }
    SlotList {
        slots: root.folder.slots;
        busy: root.busy;
        clicked(key) => { root.clicked(key); }
    }
}

component GameBlock inherits VerticalLayout {
    in property <GameRow> game;
    in property <bool> busy;
    callback clicked(int);

    spacing: 2px;

    Text {
        text: root.game.title;
        font-size: 18px;
        font-weight: 700;
        opacity: root.game.supported ? 1.0 : 0.5;
        overflow: elide;
    }
    if !root.game.supported: Text {
        text: @tr("Not supported yet");
        opacity: 0.5;
        overflow: elide;
    }
    if root.game.no-save: Text {
        text: @tr("No save found");
        overflow: elide;
    }
    SlotList {
        slots: root.game.slots;
        busy: root.busy;
        clicked(key) => { root.clicked(key); }
    }
    for folder in root.game.folders: FolderBlock {
        folder: folder;
        busy: root.busy;
        clicked(key) => { root.clicked(key); }
    }
}

// The Home screen: toolbar, messages, then the games with their saves.
export component HomeScreen inherits VerticalLayout {
    in property <[GameRow]> games;
    in property <bool> scanning;
    in property <bool> scan-failed;
    in property <int> skipped-count;
    in-out property <bool> owned-only;
    in property <bool> busy;
    in property <bool> has-open-problem;
    in property <OpenProblem> open-problem;
    callback owned-only-toggled(bool);
    callback rescan-requested();
    callback open-file-requested();
    callback slot-clicked(int);
    callback problem-dismissed();

    padding: 12px;
    spacing: 8px;

    HorizontalLayout {
        spacing: 8px;
        CheckBox {
            text: @tr("Show owned games only");
            checked <=> root.owned-only;
            toggled => { root.owned-only-toggled(self.checked); }
        }
        Rectangle { }
        Button {
            text: @tr("Refresh");
            enabled: !root.busy && !root.scanning;
            clicked => { root.rescan-requested(); }
        }
        Button {
            text: @tr("Open a file...");
            enabled: !root.busy && !root.scanning;
            clicked => { root.open-file-requested(); }
        }
    }
    if root.has-open-problem: HorizontalLayout {
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
            text: root.open-problem == OpenProblem.busy ? @tr("Another save is still opening.")
                : root.open-problem == OpenProblem.unknown-slot ? @tr("This save is no longer in the list. Refresh and try again.")
                : root.open-problem == OpenProblem.unsupported ? @tr("This game is not supported yet.")
                : root.open-problem == OpenProblem.unreadable ? @tr("The file cannot be read.")
                : root.open-problem == OpenProblem.not-a-save ? @tr("This file is not a save the editor can open.")
                : @tr("An internal error stopped the open. Try again.");
        }
        Button {
            text: @tr("OK");
            clicked => { root.problem-dismissed(); }
        }
    }
    if root.scan-failed: Text {
        text: @tr("The search for saves stopped on an internal error. Press Refresh to try again.");
        overflow: elide;
    }
    if root.scanning && root.games.length == 0: Text {
        text: @tr("Looking for saves...");
    }
    if root.skipped-count > 0: Text {
        text: @tr("Some files or folders could not be read ({})", root.skipped-count);
        overflow: elide;
    }
    ScrollView {
        VerticalLayout {
            spacing: 12px;
            for game in root.games: GameBlock {
                game: game;
                busy: root.busy;
                clicked(key) => { root.slot-clicked(key); }
            }
        }
    }
}
