// Language-dependent sentences shared by the Home screen and the editor
// page. Rust sends a kind and a number; the sentence is written here.

import { SlotKind, SummaryRow } from "types.slint";
import { EditNotice, EditProblem } from "editor-types.slint";

export global SlotText {
    pure public function name(kind: SlotKind, number: int) -> string {
        if kind == SlotKind.numbered {
            return @tr("Slot {}", number);
        }
        if kind == SlotKind.auto-save {
            return @tr("Auto save");
        }
        if kind == SlotKind.quick-save {
            return @tr("Quick save");
        }
        return @tr("Unknown slot");
    }
}

// The sentence for an edit notice. Rust sends the problem and the numbers; the
// wording lives here.
export global NoticeText {
    pure public function sentence(notice: EditNotice) -> string {
        if notice.problem == EditProblem.not-a-number {
            return @tr("{}: enter a whole number.", notice.label);
        }
        if notice.problem == EditProblem.read-only {
            return @tr("{} is locked.", notice.label);
        }
        if notice.problem == EditProblem.out-of-range {
            return @tr("{}: {} is outside {} to {}.", notice.label, notice.value, notice.min, notice.max);
        }
        if notice.problem == EditProblem.above-cap {
            return @tr("{}: {} is above the game limit of {}.", notice.label, notice.value, notice.cap);
        }
        if notice.problem == EditProblem.unknown-id {
            return @tr("{}: {} is not a known entry.", notice.label, notice.value);
        }
        if notice.problem == EditProblem.duplicate-row {
            return @tr("{} is already in the list.", notice.label);
        }
        if notice.problem == EditProblem.missing-row {
            return @tr("{} is no longer in the save.", notice.label);
        }
        if notice.problem == EditProblem.not-editable {
            return @tr("This field cannot be edited.");
        }
        if notice.problem == EditProblem.reloaded {
            return @tr("The change failed and the save was reloaded. Unsaved changes are gone.");
        }
        return @tr("An internal error stopped the edit.");
    }
}

// The one-line header of the editor page after the game title: slot, play
// time and location, each skipped when empty.
export global SummaryLine {
    pure public function rest(summary: SummaryRow) -> string {
        if summary.play-time != "" && summary.location != "" {
            return @tr("{} · {} · {}", SlotText.name(summary.kind, summary.number), summary.play-time, summary.location);
        }
        if summary.play-time != "" {
            return @tr("{} · {}", SlotText.name(summary.kind, summary.number), summary.play-time);
        }
        if summary.location != "" {
            return @tr("{} · {}", SlotText.name(summary.kind, summary.number), summary.location);
        }
        return SlotText.name(summary.kind, summary.number);
    }
}

// Party, play time and location of one save, each line skipped when empty.
export component SummaryLines inherits VerticalLayout {
    in property <SummaryRow> summary;

    spacing: 2px;

    if root.summary.party != "": Text {
        text: @tr("Party: {}", root.summary.party);
        overflow: elide;
    }
    if root.summary.play-time != "": Text {
        text: @tr("Play time: {}", root.summary.play-time);
        overflow: elide;
    }
    if root.summary.location != "": Text {
        text: @tr("Location: {}", root.summary.location);
        overflow: elide;
    }
}
