import { ScrollView } from "std-widgets.slint";
import { CharacterCard, EntityPage, Overview } from "../../types/editor.slint";
import { LookText, PortraitFrame, PressRow, RuleLine } from "../../widgets/frames.slint";

// One character: a portrait frame with the sprite (the initial when there is
// none), the job over the name, HP, the eight charges in two rows of four, the
// level, and the experience or the next level. A click, Enter or Space opens
// the character's page.
component CharacterRow inherits PressRow {
    in property <CharacterCard> card;
    in property <bool> last;

    // A fixed portrait: the card's height comes from its rows, never the
    // other way round.
    private property <length> side: 96px;
    // The label column of the stats: wide enough for "HP", "MP" and "Lv".
    private property <length> label-width: 60px;

    name: root.card.name;
    // The card keeps the height of its rows (the portrait is 96 px, the four
    // text rows are taller), whatever room the panel has.
    min-height: body.min-height;
    preferred-height: body.preferred-height;

    body := HorizontalLayout {
        padding: root.look.padding;
        spacing: root.look.padding;

        Rectangle {
            width: root.side;
            PortraitFrame {
                look: root.look;
                initial: root.card.initial;
                portrait: root.card.portrait;
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: root.side;
                height: root.side;
            }
        }
        VerticalLayout {
            min-width: 120px;
            preferred-width: 190px;
            max-width: 190px;
            alignment: center;

            LookText {
                look: root.look;
                text: root.card.job;
                font-size: root.look.font-small;
                color: root.look.muted;
                overflow: elide;
            }
            LookText {
                look: root.look;
                text: root.card.name;
                overflow: elide;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;

            HorizontalLayout {
                LookText {
                    look: root.look;
                    width: root.label-width;
                    text: @tr("HP");
                    color: root.look.label;
                }
                LookText {
                    look: root.look;
                    text: root.card.hp-max != "" ? root.card.hp + "/ " + root.card.hp-max : root.card.hp;
                    overflow: elide;
                }
            }
            if root.card.charges.length >= 8: HorizontalLayout {
                LookText {
                    look: root.look;
                    width: root.label-width;
                    text: @tr("MP");
                    color: root.look.label;
                }
                LookText {
                    look: root.look;
                    text: root.card.charges[0] + "/ " + root.card.charges[1] + "/ " + root.card.charges[2] + "/ " + root.card.charges[3];
                }
            }
            if root.card.charges.length >= 8: HorizontalLayout {
                Rectangle {
                    width: root.label-width;
                }
                LookText {
                    look: root.look;
                    text: root.card.charges[4] + "/ " + root.card.charges[5] + "/ " + root.card.charges[6] + "/ " + root.card.charges[7];
                }
            }
            HorizontalLayout {
                LookText {
                    look: root.look;
                    width: root.label-width;
                    text: @tr("Lv");
                    color: root.look.label;
                }
                LookText {
                    look: root.look;
                    text: root.card.level;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                LookText {
                    look: root.look;
                    text: root.card.next-exp != "" ? @tr("Next level") : @tr("Exp");
                    color: root.look.label;
                }
                Rectangle {
                    width: root.look.padding;
                }
                LookText {
                    look: root.look;
                    text: root.card.next-exp != "" ? root.card.next-exp : root.card.exp;
                    horizontal-alignment: right;
                }
            }
        }
    }
    if !root.last: RuleLine {
        look: root.look;
        y: parent.height - self.height;
        x: root.look.padding;
        width: parent.width - 2 * root.look.padding;
    }
}

// A character of a game with no card builder: its name, on one line.
component PlainRow inherits PressRow {
    in property <string> text;

    name: root.text;
    min-height: 34px;
    preferred-height: 34px;

    LookText {
        look: root.look;
        x: root.look.padding;
        width: parent.width - 2 * root.look.padding;
        height: parent.height;
        text: root.text;
        overflow: elide;
    }
}

// The party: each card keeps the natural height of its rows and the column
// scrolls when the cards outgrow the panel. A game with no cards lists the
// characters as plain rows.
//
// The layout cannot loop: a card's height comes from its rows only, the
// column's height is the sum of the cards, and the viewport height is the
// column's. Nothing reads the panel's height to size a card. The panel's
// height is read only to scroll a focused card into view.
export component PartyCards inherits Rectangle {
    in property <Overview> overview;
    in property <[EntityPage]> pages;
    in property <bool> enabled: true;
    // The index into the party pages.
    callback activated(int);

    // Brings the row at `top` with `height` into view. `content-y` is zero
    // or negative.
    function reveal(top: length, height: length) {
        if top < -scroll.content-y {
            scroll.content-y = -top;
        } else if top + height > -scroll.content-y + scroll.height {
            scroll.content-y = scroll.height - top - height;
        }
    }

    scroll := ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding-right: 20px;
            alignment: start;

            for card[index] in root.overview.cards: CharacterRow {
                card: card;
                last: index == root.overview.cards.length - 1;
                enabled: root.enabled;
                activated => { root.activated(card.page); }
                changed has-focus => {
                    if self.has-focus {
                        root.reveal(self.y, self.height);
                    }
                }
            }
            for page[index] in root.overview.present ? [] : root.pages: PlainRow {
                text: page.label;
                enabled: root.enabled;
                activated => { root.activated(index); }
                changed has-focus => {
                    if self.has-focus {
                        root.reveal(self.y, self.height);
                    }
                }
            }
        }
    }
}
