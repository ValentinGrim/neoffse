import { EditorCommand, EditorData, EditNotice, Overview, PickerEntry, ReviewRow } from "../../types/editor.slint";

// The state and the callbacks of the editor page. Rust fills it through
// `window.global::<EditorBridge>()`, so the nested components read it
// without property drilling.
export global EditorBridge {
    in property <EditorData> data;
    // The party overview the cards read.
    in property <Overview> overview;
    in property <[PickerEntry]> picker-entries;
    in property <bool> has-notice;
    in property <EditNotice> notice;
    // The notice is an above-cap refusal in the default mode.
    in property <bool> offer-expert;
    in property <bool> expert-mode;
    // The checkmark of the View menu item.
    in-out property <bool> expert-menu-checked;
    in property <bool> expert-warning-open;
    in property <bool> discard-dialog-open;
    // Navigation state: Rust resets it when a save opens and steps it on Back.
    // The current command of the menu.
    in-out property <EditorCommand> command: EditorCommand.party;
    // The Party command's page: -1 is the overview of the cards, otherwise an
    // index into `data.party.pages`.
    in-out property <int> character: -1;
    // The count of unsaved changes: the distance to the clean point.
    in property <int> pending-count;
    in property <bool> can-undo;
    in property <bool> can-redo;
    // The net difference the review dialog lists, rebuilt on each open.
    in property <[ReviewRow]> review-rows;
    in property <bool> review-open;
    in property <bool> game-running-open;
    in property <bool> changed-on-disk-open;
    // A save or a reload runs on a worker.
    in property <bool> working;
    // A dialog other than the discard dialog covers the page, or a worker runs:
    // a close request waits, and the controls under it stop taking input.
    out property <bool> vetoes-close: root.expert-warning-open || root.review-open
        || root.game-running-open || root.changed-on-disk-open || root.working;
    // Any modal, the discard dialog included, covers the page, or a worker runs.
    out property <bool> blocked: root.vetoes-close || root.discard-dialog-open;

    // Key and text, for the text and number kinds.
    callback field-text-committed(int, string);
    // Key and checked.
    callback field-toggled(int, bool);
    // Key and entry id.
    callback field-picked(int, int);
    // Key and index in `names`.
    callback field-name-picked(int, int);
    // Key and search text.
    callback field-picker-query(int, string);
    // List key and search text.
    callback list-picker-query(int, string);
    // List key and entry id.
    callback item-add-requested(int, int);
    // Row key.
    callback item-remove-requested(int);
    callback notice-dismissed();
    callback expert-toggle-requested();
    callback expert-warning-confirmed();
    callback expert-warning-cancelled();
    callback discard-confirmed();
    callback discard-cancelled();
    callback undo-requested();
    callback redo-requested();
    callback review-requested();
    callback review-cancelled();
    callback save-requested();
    callback save-anyway-confirmed();
    callback save-anyway-cancelled();
    callback reload-confirmed();
    callback reload-cancelled();
    callback discard-review-requested();
}
