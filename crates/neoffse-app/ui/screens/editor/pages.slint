import { ScrollView } from "std-widgets.slint";
import { EntityPage, FieldRow, ItemList, ItemRow, SectionData } from "../../types/editor.slint";
import { EditorBridge } from "bridge.slint";
import { ThemedButton } from "../../widgets/controls.slint";
import { FieldEditor, FieldLabel, FieldLine, LockMark } from "fields.slint";
import { PickerField } from "../../widgets/picker.slint";
import { LookText, PortraitFrame, RuleLine } from "../../widgets/frames.slint";
import { Icons } from "../../theme/icons.slint";
import { Look } from "../../theme/look.slint";
import { Theme } from "../../theme/theme.slint";

// The fields of one entity, scrolling when they outgrow the page.
export component FieldList inherits ScrollView {
    in property <[FieldRow]> fields;

    VerticalLayout {
        padding: 8px;
        padding-right: 20px;
        spacing: 6px;

        for field in root.fields: FieldLine {
            field: field;
        }
    }
}

// One Party character: a portrait frame holding the sprite at 2x, 64 px (the
// initial when there is none), the name and the job over the fields. Back
// returns to the cards. The sprite and the job come from the character's card,
// which Rust names for the page, so a game with no cards shows the name alone.
export component CharacterEditPage inherits VerticalLayout {
    in property <Look> look: Theme.look;
    in property <EntityPage> page;
    // Index of `page` among the party pages.
    in property <int> index;

    // The sprite side; the frame adds the two lines around it.
    private property <length> sprite-side: 64px;
    // The card that opens this page; Rust names it, so the order of the cards never
    // matters. A table shorter than the page list leaves the page without a card: an
    // out-of-range array read gives 0 in Slint, which would pick the first card.
    private property <int> card-index: root.index >= 0 && root.index < EditorBridge.overview.card-of-page.length ? EditorBridge.overview.card-of-page[root.index] : -1;
    private property <bool> has-card: root.card-index >= 0 && root.card-index < EditorBridge.overview.cards.length;

    spacing: root.look.spacing;

    HorizontalLayout {
        spacing: root.look.padding;

        if root.has-card: PortraitFrame {
            look: root.look;
            initial: EditorBridge.overview.cards[root.card-index].initial;
            portrait: EditorBridge.overview.cards[root.card-index].portrait;
            // The sprite is 32 px: 64 px inside the frame shows it at 2x, a
            // whole multiple, as on the party cards. The two lines sit outside it.
            width: root.sprite-side + 2 * self.inset;
            height: root.sprite-side + 2 * self.inset;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;

            LookText {
                look: root.look;
                text: root.page.label;
                color: root.look.selected;
                overflow: elide;
            }
            if root.has-card && EditorBridge.overview.cards[root.card-index].job != "": LookText {
                look: root.look;
                text: EditorBridge.overview.cards[root.card-index].job;
                font-size: root.look.font-small;
                color: root.look.muted;
                overflow: elide;
            }
        }
    }
    RuleLine {
        look: root.look;
    }
    FieldList {
        fields: root.page.fields;
    }
}

component ReadOnlyNote inherits LookText {
    font-size: self.look.font-small;
    color: self.look.muted;
    text: @tr("Read only");
}

// Magic: one button per character above the selected character's read-only
// slots.
export component CharacterPage inherits VerticalLayout {
    in property <Look> look: Theme.look;
    in property <[EntityPage]> pages;
    // Every field of the section is read only.
    in property <bool> read-only;

    private property <int> selected;
    // `selected` held inside the page count, so a shorter list never leaves it dangling.
    private property <int> current: max(0, min(root.selected, root.pages.length - 1));

    spacing: root.look.spacing;

    if root.pages.length == 0: LookText {
        look: root.look;
        text: @tr("Nothing to show.");
    }
    if root.pages.length > 0: HorizontalLayout {
        spacing: root.look.spacing;
        alignment: start;

        for page[index] in root.pages: ThemedButton {
            look: root.look;
            text: page.label;
            primary: index == root.current;
            enabled: !EditorBridge.blocked;
            clicked => { root.selected = index; }
        }
    }
    if root.read-only: ReadOnlyNote {
        look: root.look;
    }
    if root.pages.length > 0: RuleLine {
        look: root.look;
    }
    if root.pages.length > 0: FieldList {
        fields: root.pages[root.current].fields;
    }
}

component ItemLine inherits HorizontalLayout {
    in property <Look> look: Theme.look;
    in property <ItemRow> item;

    spacing: root.look.padding;

    FieldLabel {
        look: root.look;
        text: root.item.label;
    }
    for field in root.item.fields: FieldEditor {
        look: root.look;
        name: root.item.label;
        field: field;
        show-lock: !root.item.locked;
    }
    Rectangle {
        horizontal-stretch: 1;
    }
    if root.item.locked: LockMark {
        look: root.look;
    }
    if root.item.removable: ThemedButton {
        look: root.look;
        text: @tr("Remove");
        accessible-name: @tr("Remove {}", root.item.label);
        icon: Icons.delete;
        has-icon: true;
        enabled: root.item.can-remove && !EditorBridge.blocked;
        clicked => { EditorBridge.item-remove-requested(root.item.key); }
    }
}

component ItemBlock inherits VerticalLayout {
    in property <Look> look: Theme.look;
    in property <ItemList> list;

    spacing: 6px;

    HorizontalLayout {
        spacing: root.look.padding;

        LookText {
            look: root.look;
            horizontal-stretch: 1;
            text: root.list.title;
            color: root.look.selected;
            overflow: elide;
        }
        if root.list.insertable: PickerField {
            look: root.look;
            entries: EditorBridge.picker-entries;
            enabled: !EditorBridge.blocked;
            icon: Icons.add;
            has-icon: true;
            button-text: @tr("Add...");
            accessible-name: @tr("Add to {}", root.list.title);
            opened => { EditorBridge.list-picker-query(root.list.key, ""); }
            query-changed(text) => { EditorBridge.list-picker-query(root.list.key, text); }
            chosen(id) => { EditorBridge.item-add-requested(root.list.key, id); }
        }
    }
    RuleLine {
        look: root.look;
    }
    for item in root.list.rows: ItemLine {
        look: root.look;
        item: item;
    }
}

// Inventory: the single-field entities (gil) on top, then each item list.
export component InventoryPage inherits ScrollView {
    in property <Look> look: Theme.look;
    in property <SectionData> section;

    VerticalLayout {
        padding: 8px;
        padding-right: 20px;
        spacing: root.look.padding;

        if root.section.read-only: ReadOnlyNote {
            look: root.look;
        }
        VerticalLayout {
            spacing: 6px;
            for page in root.section.pages: VerticalLayout {
                spacing: 6px;
                for field in page.fields: FieldLine {
                    look: root.look;
                    field: field;
                }
            }
        }
        for list in root.section.lists: ItemBlock {
            look: root.look;
            list: list;
        }
    }
}
