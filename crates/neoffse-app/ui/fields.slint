import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette } from "std-widgets.slint";
import { FieldKind, FieldRow, PickerEntry } from "editor-types.slint";
import { EditorBridge } from "bridge.slint";

// A text box that sends one edit per commit: Enter or focus loss, and only
// when the text differs from `source`. After every commit, accepted or
// refused, the box shows the document's value again.
export component CommitEdit inherits Rectangle {
    in property <string> source;
    in property <bool> enabled: true;
    in property <TextHorizontalAlignment> alignment: left;
    callback committed(string);

    min-width: edit.min-width;
    min-height: edit.min-height;
    preferred-width: edit.preferred-width;
    preferred-height: edit.preferred-height;

    function commit() {
        if edit.text != root.source {
            root.committed(edit.text);
        }
        edit.text = root.source;
    }

    changed source => { edit.text = root.source; }

    edit := LineEdit {
        width: 100%;
        height: 100%;
        text: root.source;
        enabled: root.enabled;
        horizontal-alignment: root.alignment;
        accepted => { root.commit(); }
        changed has-focus => {
            if !self.has-focus {
                root.commit();
            }
        }
    }
}

// A button that opens a searchable list of entries. Rust filters the list:
// `query-changed` asks for a new one, `entries` holds the answer.
export component PickerField inherits Rectangle {
    in property <string> button-text;
    in property <bool> enabled: true;
    in property <[PickerEntry]> entries;
    callback opened();
    callback query-changed(string);
    callback chosen(int);

    private property <string> query;

    min-width: button.min-width;
    min-height: button.min-height;
    preferred-width: button.preferred-width;
    preferred-height: button.preferred-height;

    button := Button {
        width: 100%;
        height: 100%;
        text: root.button-text;
        enabled: root.enabled;
        clicked => {
            root.query = "";
            root.opened();
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height;
        width: 280px;
        height: 280px;
        close-policy: close-on-click-outside;
        forward-focus: search;

        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 4px;

            VerticalLayout {
                padding: 6px;
                spacing: 6px;

                search := LineEdit {
                    text <=> root.query;
                    placeholder-text: @tr("Search");
                    edited(text) => { root.query-changed(text); }
                }
                ListView {
                    for entry in root.entries: Rectangle {
                        height: 28px;
                        background: touch.has-hover ? Palette.accent-background.with-alpha(0.25) : transparent;

                        touch := TouchArea {
                            clicked => {
                                root.chosen(entry.id);
                                popup.close();
                            }
                        }
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            vertical-alignment: center;
                            overflow: elide;
                            text: entry.name != "" ? entry.name : @tr("Entry {}", entry.id);
                        }
                    }
                }
            }
        }
    }
}

// The control a field gets, chosen by `field.kind`. Every callback goes to the
// bridge; the control never holds the value, so a refusal shows the document's
// value again.
export component FieldEditor inherits HorizontalLayout {
    in property <FieldRow> field;
    // The small "locked" mark; a row that shows its own mark turns this off.
    in property <bool> show-lock: true;

    spacing: 8px;

    if root.field.kind == FieldKind.label: Text {
        horizontal-stretch: 1;
        vertical-alignment: center;
        overflow: elide;
        text: root.field.shown != "" ? root.field.shown : root.field.text;
    }
    if root.field.kind == FieldKind.text: CommitEdit {
        horizontal-stretch: 1;
        source: root.field.text;
        enabled: root.field.editable;
        committed(text) => { EditorBridge.field-text-committed(root.field.key, text); }
    }
    if root.field.kind == FieldKind.number: CommitEdit {
        max-width: 200px;
        source: root.field.text;
        enabled: root.field.editable;
        alignment: right;
        committed(text) => { EditorBridge.field-text-committed(root.field.key, text); }
    }
    if root.field.kind == FieldKind.number && root.field.cap != "": Text {
        vertical-alignment: center;
        font-size: 11px;
        opacity: 0.7;
        text: @tr("game limit {}", root.field.cap);
    }
    if root.field.kind == FieldKind.number && root.field.above-cap: Text {
        vertical-alignment: center;
        font-size: 11px;
        color: #d08000;
        text: @tr("above the game limit");
    }
    if root.field.kind == FieldKind.choice: ComboBox {
        model: root.field.names;
        current-index: root.field.name-index;
        enabled: root.field.editable;
        selected => {
            EditorBridge.field-name-picked(root.field.key, self.current-index);
            self.current-index = root.field.name-index;
        }
    }
    if root.field.kind == FieldKind.choice: CommitEdit {
        max-width: 200px;
        source: root.field.text;
        enabled: root.field.editable;
        alignment: right;
        committed(text) => { EditorBridge.field-text-committed(root.field.key, text); }
    }
    if root.field.kind == FieldKind.picker: PickerField {
        width: 220px;
        entries: EditorBridge.picker-entries;
        enabled: root.field.editable;
        button-text: root.field.known && root.field.shown != "" ? root.field.shown
            : root.field.known ? @tr("Entry {}", root.field.text)
            : @tr("Unknown ({})", root.field.text);
        opened => { EditorBridge.field-picker-query(root.field.key, ""); }
        query-changed(text) => { EditorBridge.field-picker-query(root.field.key, text); }
        chosen(id) => { EditorBridge.field-picked(root.field.key, id); }
    }
    if root.field.kind == FieldKind.toggle: CheckBox {
        checked: root.field.checked;
        enabled: root.field.editable;
        toggled => {
            EditorBridge.field-toggled(root.field.key, self.checked);
            self.checked = root.field.checked;
        }
    }
    if root.field.locked && root.show-lock && root.field.kind != FieldKind.label: Text {
        vertical-alignment: center;
        font-size: 11px;
        opacity: 0.7;
        text: @tr("locked");
    }
}

// A field with its label on the left.
export component FieldLine inherits HorizontalLayout {
    in property <FieldRow> field;

    spacing: 12px;

    Text {
        width: 180px;
        vertical-alignment: center;
        overflow: elide;
        text: root.field.label;
    }
    FieldEditor {
        field: root.field;
    }
}
