import { Palette } from "std-widgets.slint";

// A dialog drawn over the whole window: a dimmed background that swallows
// clicks, and a centred card with a title, a message and a row of buttons.
// The caller puts the buttons in as children, so a dialog can carry two or
// three without a change here.
export component ModalDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;

    width: 100%;
    height: 100%;
    background: #000000a0;

    // Swallows every click and scroll that would reach the page below.
    TouchArea { }

    Rectangle {
        width: min(root.width - 32px, 440px);
        height: 190px;
        background: Palette.background;
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 8px;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            Text {
                text: root.title;
                color: Palette.foreground;
                font-size: 18px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                vertical-stretch: 1;
                text: root.message;
                color: Palette.foreground;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                @children
            }
        }
    }
}
